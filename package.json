{
  "name": "mid2030-lca-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,section-export,autofill,routing -c blue,green,magenta,cyan \"vite --host 0.0.0.0 --port 3000\" \"node server/section-export-server.js\" \"node server/material-autofill-server.js\" \"node server/routing-server.js\"",
    "dev:vite-only": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "electron:dist": "npm run build && electron-packager . \"MID2030-Assembly-Builder\" --platform=win32 --arch=x64 --out=release-pkg --overwrite --ignore=\"^/release($|-build|-pkg)\" --ignore=\"^/server\""
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.4",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "canvg": "^4.0.3",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-image": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.9.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-packager": "^17.1.2",
    "vite": "^5.4.0"
  }
}
